{
  "name": "claudigotchi",
  "version": "0.1.0",
  "description": "Claude Code with a soul. A full Claude Code UI replacement with a living Tamagotchi-style pet.",
  "main": "electron.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "fix-wincodesign": "node scripts/fix-wincodesign-cache.js",
    "build": "vite build && npm run fix-wincodesign && electron-builder --win nsis portable",
    "build:dir": "vite build && electron-builder --dir",
    "release": "vite build && npm run fix-wincodesign && electron-builder --win nsis portable --publish always",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "@anthropic-ai/claude-code": "^2.1.0",
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@uiw/codemirror-theme-dracula": "^4.25.9",
    "chess.js": "^1.4.0",
    "electron-updater": "^6.3.9",
    "highlight.js": "^11.10.0",
    "prettier": "^3.8.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "sharp": "^0.34.5",
    "to-ico": "^1.1.5",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.kl3mta3.claudigotchi",
    "productName": "Claudagotchi",
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "preload.js",
      "preload-splash.js",
      "splash.html",
      "public/**/*",
      "cli-bridge/**/*",
      "scripts/**/*"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-code/bin/**/*",
      "node_modules/@anthropic-ai/claude-code-*/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "signtoolOptions": {
        "sign": "scripts/sign.js",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Claudagotchi"
    },
    "portable": {
      "artifactName": "Claudagotchi-${version}-portable.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "kl3mta3",
      "repo": "Claudigotchi",
      "releaseType": "release"
    }
  }
}
