# Claudagotchi shares its Azure Trusted Signing setup with Vitriol — the AzTS
# account+profile is per-publisher, so the same three vars sign both apps.
#
# scripts/sign.js does NOT read a .env file (Vitriol's pattern: env vars in
# the shell are canonical). Set these in your User environment via
# `setx VITRIOL_AZTS_ENDPOINT ...` once, OR export them per-shell before
# `npm run build`. This file is for reference only.

VITRIOL_AZTS_ENDPOINT=https://eus.codesigning.azure.net/
VITRIOL_AZTS_ACCOUNT=
VITRIOL_AZTS_PROFILE=

# Optional overrides:
# VITRIOL_AZTS_DLIB=C:\Users\Kenny\.nuget\packages\azure.codesigning.dlib\<ver>\bin\x64\Azure.CodeSigning.Dlib.dll
# VITRIOL_AZTS_TS_URL=http://timestamp.acs.microsoft.com
# VITRIOL_SIGNTOOL=C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe
# SIGN_DESCRIPTION=Claudagotchi
# SIGN_URL=https://github.com/kl3mta3/Claudagotchi

# Azure auth (NOT read by sign.js — used by the AzTS dlib via Azure.Identity).
# For local dev: run `az login` once instead of setting these.
# For CI: set all three.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# GitHub Releases (electron-builder + electron-updater). Only needed for publishing.
# GH_TOKEN=
