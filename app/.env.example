# Copy to `.env` (gitignored) and fill in your Azure Trusted Signing credentials.
# Required by scripts/sign.js — without these the build produces UNSIGNED binaries.

# Microsoft Entra service principal (App Registration → Certificates & secrets)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure Trusted Signing account (Azure Portal → Trusted Signing)
# Endpoint examples:
#   East US:   https://eus.codesigning.azure.net
#   West EU:   https://weu.codesigning.azure.net
AZURE_TRUSTED_SIGNING_ENDPOINT=
AZURE_TRUSTED_SIGNING_ACCOUNT=
AZURE_TRUSTED_SIGNING_PROFILE=

# Optional overrides:
# SIGNTOOL_PATH=C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe
# TRUSTED_SIGNING_DISPATCHER=C:\Program Files\Microsoft\Trusted Signing\Azure.CodeSigning.Dispatcher.dll

# GitHub Releases (electron-builder + electron-updater)
# Personal Access Token with `repo` scope; only needed when publishing.
GH_TOKEN=
