# ─── Node ─────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/

# ─── Build outputs ────────────────────────────────────────────────────────
dist/
dist-electron/
build/
out/
*.tsbuildinfo

# ─── Electron / packager caches ───────────────────────────────────────────
.cache/
.parcel-cache/
.vite/
.electron-builder-cache/

# ─── Logs ─────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Env / secrets ────────────────────────────────────────────────────────
.env
.env.*
!.env.example
# Code-signing credentials. Real files live in $HOME (e.g.
# ~/.claudagotchi-sign-env.ps1) — this guards against accidental copies
# into the repo for inspection.
.claudagotchi-sign-env.ps1
.vitriol-sign-env.ps1
*sign-env*.ps1
*sign-env*.sh
*-secret*.ps1
*-secret*.env

# ─── OS junk ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor / IDE ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# ─── Tooling / coverage ───────────────────────────────────────────────────
coverage/
.nyc_output/
.eslintcache
.stylelintcache

# ─── App-specific (NOT in repo) ───────────────────────────────────────────
# User save data lives in %USERPROFILE%\.claudigotchi\ — outside the repo, ignored by default
# But if anyone copies it in, exclude:
.claudigotchi/
*.save.json
[Cc][Ll][Aa][Uu][Dd][Ee].[Mm][Dd]

# Test snapshots / temporary fixtures
__snapshots__/
*.snap
tmp/
temp/
docs/

# ─── Packaged installers (if you ever build them) ─────────────────────────
*.exe
*.dmg
*.AppImage
*.msi
*.deb
*.rpm
